// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// === ENUM ===
enum LoginStatus {
  SUCCESS
  FAILED
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  isRoot      Boolean   @default(false) @map("is_root")
  username    String    @unique
  password    String
  avatar      String?
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phoneNumber String?   @unique @map("phone_number")
  dateOfBirth DateTime? @map("date_of_birth")

  userRoles UserRole[]

  @@index([username])
  @@map("users")
}

model Role {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  code        String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  code        String  @unique
  name        String
  description String?
  group       String

  rolePermissions RolePermission[]

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A release is a draft until publishedAt is set. Published artifacts are immutable.
model AppRelease {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  version         String    @unique
  installerName   String    @map("installer_name")
  installerSize   Int       @map("installer_size")
  installerSha512 String    @map("installer_sha512")
  blockmapSize    Int       @map("blockmap_size")
  blockmapSha512  String    @map("blockmap_sha512")
  // Manifest returned by the stable feed; URLs point to immutable versioned files.
  manifest        String
  publishedAt     DateTime? @map("published_at")

  channel AppReleaseChannel?

  @@index([createdAt])
  @@map("app_releases")
}

// One stable pointer, updated in the same DB transaction as publication metadata.
model AppReleaseChannel {
  name      String     @id
  releaseId Int        @unique @map("release_id")
  release   AppRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@map("app_release_channels")
}
