// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// === ENUM ===
enum LoginStatus {
  SUCCESS
  FAILED
}

enum TenantType {
  PERSONAL
  ORGANIZATION
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PENDING
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  isRoot      Boolean   @default(false) @map("is_root")
  username    String    @unique
  email       String?   @unique
  password    String
  avatar      String?
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phoneNumber String?   @unique @map("phone_number")
  dateOfBirth DateTime? @map("date_of_birth")

  userRoles       UserRole[]
  tenantMembers   TenantMember[]
  upgradeRequests UpgradeRequest[]

  @@index([username])
  @@index([email])
  @@map("users")
}

model Role {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  code        String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  code        String  @unique
  name        String
  description String?
  group       String

  rolePermissions RolePermission[]

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A release is a draft until publishedAt is set. Published artifacts are immutable.
model AppRelease {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  version         String    @unique
  installerName   String    @map("installer_name")
  installerSize   Int       @map("installer_size")
  installerSha512 String    @map("installer_sha512")
  blockmapSize    Int       @map("blockmap_size")
  blockmapSha512  String    @map("blockmap_sha512")
  // Manifest returned by the stable feed; URLs point to immutable versioned files.
  manifest        String
  publishedAt     DateTime? @map("published_at")

  channel AppReleaseChannel?

  @@index([createdAt])
  @@map("app_releases")
}

// One stable pointer, updated in the same DB transaction as publication metadata.
model AppReleaseChannel {
  name      String     @id
  releaseId Int        @unique @map("release_id")
  release   AppRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@map("app_release_channels")
}

// === SAAS MULTI-TENANT & SUBSCRIPTIONS ===

model Plan {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  code                String   @unique
  name                String
  description         String?
  badge               String?
  priceMonthly        Int      @default(0) @map("price_monthly")
  priceYearly         Int      @default(0) @map("price_yearly")
  currency            String   @default("VND")
  monthlyMinutesLimit Int?     @map("monthly_minutes_limit")
  maxSeats            Int      @default(1) @map("max_seats")
  features            String[] @default([])
  isPublic            Boolean  @default(true) @map("is_public")
  isDefault           Boolean  @default(false) @map("is_default")
  isHighlighted       Boolean  @default(false) @map("is_highlighted")
  sortOrder           Int      @default(0) @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active")

  subscriptions   TenantSubscription[]
  upgradeRequests UpgradeRequest[]

  @@index([isActive, isPublic, sortOrder])
  @@map("plans")
}

model Tenant {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  code         String       @unique
  name         String
  type         TenantType   @default(PERSONAL)
  status       TenantStatus @default(ACTIVE)
  contactEmail String?      @map("contact_email")
  notes        String?

  members         TenantMember[]
  subscriptions   TenantSubscription[]
  monthlyUsages   TenantUsageMonthly[]
  upgradeRequests UpgradeRequest[]

  @@index([status, type])
  @@map("tenants")
}

model TenantMember {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId Int              @map("tenant_id")
  userId   Int              @map("user_id")
  role     TenantMemberRole @default(MEMBER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

model TenantSubscription {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId                    Int                @map("tenant_id")
  planId                      Int                @map("plan_id")
  status                      SubscriptionStatus @default(ACTIVE)
  billingCycle                BillingCycle       @default(MONTHLY) @map("billing_cycle")
  startsAt                    DateTime           @default(now()) @map("starts_at")
  expiresAt                   DateTime?          @map("expires_at")
  monthlyMinutesLimitOverride Int?               @map("monthly_minutes_limit_override")
  note                        String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([planId])
  @@map("tenant_subscriptions")
}

model TenantUsageMonthly {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId      Int    @map("tenant_id")
  period        String
  usedSeconds   Int    @default(0) @map("used_seconds")
  dubbedCues    Int    @default(0) @map("dubbed_cues")
  sessionsCount Int    @default(0) @map("sessions_count")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([period])
  @@map("tenant_usage_monthly")
}

model UpgradeRequest {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId        Int                  @map("tenant_id")
  userId          Int                  @map("user_id")
  requestedPlanId Int                  @map("requested_plan_id")
  billingCycle    BillingCycle         @default(MONTHLY) @map("billing_cycle")
  status          UpgradeRequestStatus @default(PENDING)
  contactNote     String?              @map("contact_note")
  adminNote       String?              @map("admin_note")
  resolvedAt      DateTime?            @map("resolved_at")

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedPlan Plan   @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("upgrade_requests")
}
